PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins (5173 = vite dev, 4173 = vite preview)
CLIENT_URL=http://localhost:5173,http://localhost:4173

MONGO_URI=mongodb://127.0.0.1:27017/hirely
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: avatar uploads return 503 until these are set
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AI helpers return 503 until this is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
